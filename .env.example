# Copy this file to .env.local and fill in the values from the Cognito console.
# .env.local is ignored by git. These IDs are not secrets, but keep them out of GitHub anyway.

# Cognito -> User pools -> olist-web -> Overview -> User pool ID
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# Cognito -> App clients -> olist-web -> Client ID
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Cognito -> Branding -> Domain (full https URL, no trailing slash)
VITE_COGNITO_DOMAIN=https://us-east-1xxxxxxxx.auth.us-east-1.amazoncognito.com
VITE_AWS_REGION=us-east-1

# Where Cognito sends the user after login and logout (must match the app client settings)
VITE_REDIRECT_URI=http://localhost:5173

# API Gateway URL (Phase 3). Leave empty until the API exists.
VITE_API_URL=
